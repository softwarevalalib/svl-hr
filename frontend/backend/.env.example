# Neon Postgres (required in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3001

# Comma-separated frontend origins (Vercel URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:3002

# Optional SMTP for email notifications (leave blank to log-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@svlhrm.local
